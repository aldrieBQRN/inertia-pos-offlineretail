# =====================================================
# InfinityFree Production Environment Template
# =====================================================
# Copy this to .env on your InfinityFree server,
# or set these as GitHub Secrets for CI/CD deployment.
#
# DO NOT commit .env — this file (.env.infinityfree.example)
# is safe to commit as it contains no real secrets.
# =====================================================

APP_NAME="Inertia POS Demo"
APP_ENV=production
APP_KEY=                          # Generate: php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://yourdomain.rf.gd  # Your InfinityFree subdomain or custom domain

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=10

LOG_CHANNEL=single
LOG_LEVEL=warning

# ── Database (InfinityFree MySQL) ─────────────────────
# Get these from InfinityFree Control Panel → MySQL Databases
DB_CONNECTION=mysql
DB_HOST=sql200.infinityfree.com   # Your InfinityFree MySQL host (varies per account)
DB_PORT=3306
DB_DATABASE=if0_12345678_pos      # Your DB name (auto-prefixed by InfinityFree)
DB_USERNAME=if0_12345678          # Your DB username
DB_PASSWORD=                      # Your DB password

# ── Session & Cache (file drivers work on shared hosting) ──
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

AUDIT_QUEUE_ENABLED=false
MAIL_MAILER=log

VITE_APP_NAME="Inertia POS Demo"

# ── Web Migration Runner (delete after first use!) ────
# Set a long random string here and in GitHub Secrets
MIGRATE_TOKEN=                    # e.g. openssl rand -hex 32

